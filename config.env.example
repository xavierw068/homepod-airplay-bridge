# HomePod Bridge 本地配置 (local machine configuration)
# ------------------------------------------------------------------
# 1. 复制为 config.env 并填写你自己的值:
#       cp config.env.example config.env
# 2. config.env 已被 .gitignore 忽略,不会进入 git。
# 所有脚本读取这里的变量;把硬编码的 IP/路径留给你自己的环境。
#
# Copy this to config.env and fill in your own values. config.env is
# gitignored, so your local settings never get committed.

# --- 网络 (network) ---
# 运行桥接的这台 Linux 机器 IP
# IP of the machine running the bridge
SERVER_IP=192.168.0.99

# HomePod 立体声对主设备的 IP(relay 路径的目标)
# IP of the HomePod (or the primary of a stereo pair) - relay path target
HOMEPOD_IP=192.168.0.199

# --- PipeWire 虚拟 sink (virtual sink) ---
# 需要预先创建;所有被捕获播放的声音都走它
# Must be created beforehand; all captured playback is routed through it
BRIDGE_SINK=homepod-bridge-sink

# 本机喇叭 sink 名(可选;homepod-audio.sh 找不到时作 fallback)
# Local speaker sink name (optional fallback for homepod-audio.sh)
LOCAL_SINK=

# --- 端口 (ports) ---
HTTP_PORT=9000                  # 音频流 HTTP 端口 (audio stream HTTP port)
SLIMPROTO_PORT=3483             # slimproto TCP 端口 (slimproto TCP port)
DACP_PORT=40099                 # DACP 服务端口 (DACP service port)
DACP_PORT_RANGE=40000:100       # squeeze2raop -a 参数(DACP 端口区间) / squeeze2raop -a flag

# --- 二进制路径 (binary paths) ---
# squeeze2raop 二进制(从上游 lms-raop 构建,见 README)
# squeeze2raop binary (built from upstream lms-raop, see README)
SQUEEZE2RAOP_BIN=/tmp/squeeze2raop

# cliraop 二进制(仅 relay 路径需要)
# cliraop binary (relay path only)
CLIRAOP_BIN=/tmp/cliraop

# relay 路径用的 python-zeroconf 环境(可选;留空则用系统 python3)
# python-zeroconf environment for the relay path (optional; leave empty to use system python3)
PYZEROCONF_PYTHON=

# squeeze2raop 配置文件(复制自 config/raopbridge.xml.example 并填写)
# squeeze2raop config file (copy from config/raopbridge.xml.example and fill in)
RAOP_CONFIG=config/raopbridge.xml
